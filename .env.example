NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google Search Console HTML-tag verification token (optional)
NEXT_PUBLIC_GSC_VERIFICATION=
# Direct Google Business Profile review link. Get it from GBP -> Ask for reviews.
GOOGLE_REVIEW_URL=

RESEND_API_KEY=
CONTACT_RECIPIENT_EMAIL=contact@example.com
CONTACT_FROM_EMAIL=Website <onboarding@resend.dev>

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Alternative to NEXT_PUBLIC_SUPABASE_ANON_KEY (Supabase publishable key format)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio SMS notifications (optional — set to enable SMS alerts on contact form submits)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
CONTACT_SMS_TO=

# Used by /api/cron/marketing-reminders to validate Vercel Cron requests.
# Generate a random value and set the same value in Vercel project env.
CRON_SECRET=

# Meta (Facebook) OAuth — Phase 1b auto-posting
# Create an app at developers.facebook.com. Requires Business Verification + App Review.
META_APP_ID=
META_APP_SECRET=

# Google OAuth for YouTube auto-upload — Phase 1b auto-posting
# Create credentials at console.cloud.google.com. OAuth consent screen must be verified.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth redirect base URL. Defaults to https://www.double-le-hvac.com in production.
# Override for local dev (e.g., ngrok tunnel) or staging.
OAUTH_REDIRECT_BASE_URL=

# Evolink AI API — Image, video, and music generation for marketing content
# Get API key at https://evolink.ai
# Docs: https://docs.evolink.ai/en/api-manual
EVOLINK_API_KEY=
EVOLINK_BASE_URL=https://api.evolink.ai/v1

# Buffer GraphQL API — creates/schedules Buffer posts from Marketing Studio.
BUFFER_API_KEY=
BUFFER_ORGANIZATION_ID=

# OpenClaw Cloud chat gateway — used by the admin Marketing chat UI.
# Endpoint follows OpenClaw's OpenAI-compatible /v1/chat/completions contract.
OPENCLAW_GATEWAY_URL=https://agent.open-claw.bot
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_AGENT_MODEL=openclaw/default
# Optional: force the underlying provider model for OpenClaw cloud.
OPENCLAW_PROVIDER_MODEL=
