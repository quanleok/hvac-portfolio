# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase
supabase/.temp/

# dev artifacts
.playwright-mcp/
/*.png

# local claude config
.claude/
seo-reports/

# local-only notes (credentials, scratch)
docs/local-credentials.md
docs/local-*.md
!docs/local-credentials.example.md

# personal / recovery notes — never commit
*recovery*.rtf
*recovery*.md
*.rtf

# nested .next build caches
**/.next/

# superpowers brainstorm scratch content (visual companion, etc.)
.superpowers/

# evolink API keys and secrets
.secrets/
.evolink.env
*.evolink.env

# Signed consent records belong in private business storage
/public/sms-opt-in-evidence.jpg

# Private workspace context and operational captures
/USER.md
/TOOLS.md
/MEMORY.md
/memory/
/.openclaw/
/dogfood-output/

# Private consent records and credential exports
/public/sms-opt-in-evidence.*
/private-records/
*.key
*.p12
*.pfx
credentials*.json
service-account*.json
